<?xml version="1.0"?>
<package format="3">
  <name>drone_dynamics</name>
  <version>0.1.0</version>
  <description>ROS2 adapter node for the ROS-independent quadrotor dynamics.</description>
  <maintainer email="tang@example.com">Tang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>drone_core</depend>
  <depend>drone_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

