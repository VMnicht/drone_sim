<?xml version="1.0"?>
<package format="3">
  <name>drone_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration files for the ROS2 drone simulator.</description>
  <maintainer email="tang@example.com">Tang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>drone_dynamics</exec_depend>
  <exec_depend>drone_controller</exec_depend>
  <exec_depend>drone_visualization</exec_depend>
  <exec_depend>drone_tools</exec_depend>
  <exec_depend>drone_trajectory</exec_depend>
  <exec_depend>drone_sensors</exec_depend>
  <exec_depend>drone_map</exec_depend>
  <exec_depend>drone_perception</exec_depend>
  <exec_depend>drone_planner</exec_depend>
  <exec_depend>drone_fleet</exec_depend>
  <exec_depend>drone_ground_station</exec_depend>
  <exec_depend>drone_faults</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>visualization_msgs</test_depend>
  <test_depend>drone_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
