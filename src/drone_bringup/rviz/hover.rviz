Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Drone Model
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Goal
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/goal_marker
    - Class: rviz_default_plugins/Path
      Color: 255; 85; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Actual Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/path
    - Class: rviz_default_plugins/Path
      Color: 55; 210; 90
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Mission Waypoints
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/mission_path
  Enabled: true
  Global Options:
    Background Color: 35; 38; 46
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Hover View
      Pitch: 0.45
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1400
