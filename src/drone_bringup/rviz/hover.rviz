Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Drone Model
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Goal
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/goal_marker
    - Class: rviz_default_plugins/Path
      Color: 255; 85; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Actual Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/path
    - Class: rviz_default_plugins/Path
      Color: 55; 210; 90
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Mission Waypoints
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/mission_path
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Obstacles
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map/obstacle_markers
    - Class: rviz_default_plugins/Path
      Color: 70; 160; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Planned Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/planned_path
    - Class: rviz_default_plugins/Path
      Color: 225; 75; 235
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Analytic Trajectory
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/trajectory_path
    - Class: rviz_default_plugins/PointCloud2
      Alpha: 0.85
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 65; 210; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Local Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/local_points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Local Voxels
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/voxel_map
    - Class: rviz_default_plugins/Wrench
      Alpha: 1
      Enabled: true
      Force Arrow Scale: 0.25
      Name: Disturbance
      Torque Arrow Scale: 0.5
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/disturbance
  Enabled: true
  Global Options:
    Background Color: 35; 38; 46
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point:
        X: -0.62
        Y: 1.08
        Z: 0.89
      Name: Hover View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 60
